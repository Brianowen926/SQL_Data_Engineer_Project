# Fungsi fitignore untuk tidak men track file yang tidak diinginkan
#Ini standar dalam dunia programming 
# Ketika buat project, ini dibuat di awal
NOTE/

# 🗄️ Local databases
*.duckdb
*.duckdb.wal
*.sqlite
*.db

# 📊 Raw data
/data/raw/
/data/tmp/
/data/intermediate/
/exports/

# 🔐 Secrets
.env
.env.*
*.key
*.pem

# 💻 System files
.DS_Store
Thumbs.db

# 📂 Logs and temp files
logs/
tmp/
*.log

# ⚙️ Tooling (dbt, VS Code, venvs, etc.)
target/
.idea/
.vscode/
__pycache__/